ch as a tab in a tab bar.","type":"text"}],"type":"topic","kind":"symbol","role":"symbol","title":"FullScreenViewController","url":"\/documentation\/feltembeddedcare\/fullscreenviewcontroller","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FullScreenViewController","kind":"identifier"}],"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenViewController","navigatorTitle":[{"text":"FullScreenViewController","kind":"identifier"}]},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare":{"role":"collection","url":"\/documentation\/feltembeddedcare","title":"FeltEmbeddedCare","abstract":[],"type":"topic","kind":"symbol","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare"},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/EmbeddedCare/shared":{"abstract":[],"type":"topic","kind":"symbol","role":"symbol","title":"shared","url":"\/documentation\/feltembeddedcare\/embeddedcare\/shared","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"shared"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@M@FeltEmbeddedCare@objc(cs)EmbeddedCare","kind":"typeIdentifier","text":"EmbeddedCare"}],"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/shared"},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/Component":{"role":"symbol","navigatorTitle":[{"text":"Component","kind":"identifier"}],"url":"\/documentation\/feltembeddedcare\/component","title":"Component","abstract":[{"type":"text","text":"A "},{"code":"View","type":"codeVoice"},{"type":"text","text":" used to integrate Felt’s embedded care content alongside your app’s native "},{"code":"SwiftUI","type":"codeVoice"},{"type":"text","text":" content"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/