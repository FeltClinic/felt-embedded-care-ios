{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","text":"Initialization","level":2,"anchor":"Initialization"},{"inlineContent":[{"text":"Primary interaction with the SDK is mediated through the ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/shared","isActive":true},{"text":" singleton.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"At app launch, initialize the SDK with your SDK key using ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/initialize(sdkKey:)","isActive":true},{"text":".","type":"text"}]},{"type":"heading","text":"UIKit","anchor":"UIKit","level":3},{"code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","class AppDelegate: UIApplicationDelegate {","    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        Task {","            do {","                try await EmbeddedCare.shared.initalize(sdkKey: feltSDKKey)","                \/\/ Update any UI waiting on embedded care initialization","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"SwiftUI","level":3,"anchor":"SwiftUI"},{"code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","@main","struct ClientApp: App {","","    @State var embeddedCareInitialized = false","","    init() {","        Task {","            do {","                try await EmbeddedCare.shared.initialize(sdkKey: sdkKey)","                embeddedCareInitialized = true","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"User Account and Patient Details","level":2,"anchor":"User-Account-and-Patient-Details"},{"type":"heading","text":"Account","level":3,"anchor":"Account"},{"inlineContent":[{"text":"Once your app’s current user has been authenticated, provide their account details to the SDK using ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/AuthManager\/account","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let user = ...","EmbeddedCare.shared.auth.account = Account(id: user.id, email: user.email)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When the user logs out, inform the SDK by setting "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/AuthManager\/account","isActive":true},{"type":"text","text":" to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["EmbeddedCare.shared.auth.account = nil"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Selected-Patient","type":"heading","text":"Selected Patient"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK considers the logged in person currently using your app to be a "},{"code":"patient","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Your user’s account may be the same person or a distinct person from the actual patient using your app."},{"type":"text","text":" "},{"type":"text","text":"For example, the account holder may be a parent and the patient may be their child."},{"type":"text","text":" "},{"type":"text","text":"Even if the account holder and patient represent the same person, take care to distinguish their ids"},{"type":"text","text":" "},{"type":"text","text":"if your app’s data model keeps them distinct."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Account\/selectedPatient"},{"type":"text","text":" property to provide patient details to the SDK for the currently logged in patient."}]},{"syntax":"swift","type":"codeListing","code":["let currentFamilyMember = ...","EmbeddedCare.shared.auth.account?.selectedPatient = Patient(","    id: currentFamilyMember.id,","    relationshipToAccountHolder: .familyMember,","    email: currentFamilyMember.email,","    \/\/ Any custom information you want to provide","    custom: [\"notes\" : currentFamilyMember.notes]",")"]},{"inlineContent":[{"type":"text","text":"If any information changes about the account or the selected patient, just update "},{"type":"codeVoice","code":"EmbeddedCare\/account"},{"type":"text","text":" with the latest information."}],"type":"paragraph"},{"text":"Component Experiences","anchor":"Component-Experiences","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"In order to integrate Felt embedded care content alongside your app’s native content, use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentView"},{"type":"text","text":", a "},{"code":"UIView","type":"codeVoice"},{"type":"text","text":" subclass, or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Component"},{"type":"text","text":", a "},{"code":"SwiftUI","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"See the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentExperience"},{"type":"text","text":" "},{"code":"enum","type":"codeVoice"},{"type":"text","text":" for available options."}],"type":"paragraph"},{"type":"heading","text":"UIKit","level":3,"anchor":"UIKit"},{"code":["let componentView = ComponentView(experience: .dismissableCallToAction, custom: [:])","self.view.addSubview(componentView)","..."],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"SwiftUI","level":3,"anchor":"SwiftUI"},{"code":["struct MyView: View {","    var body: some View {","        Component(experience: .dismissableCallToAction, custom: [:])","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Layout","level":3,"anchor":"Layout"},{"inlineContent":[{"type":"text","text":"Component contents may be loaded asynchronously, which means a component’s layout can change over time. A component determines its intrinsic height based on its current width."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both "},{"code":"UIKit","type":"codeVoice"},{"type":"text","text":" and "},{"code":"SwiftUI","type":"codeVoice"},{"type":"text","text":" components provide the ability to specify an "},{"code":"onHeightUpdated","type":"codeVoice"},{"type":"text","text":" handler that allows you to react to intrinsic height changes. For example, you can use this handler to animate layout changes."}],"type":"paragraph"},{"type":"heading","text":"Full Screen Experiences","level":2,"anchor":"Full-Screen-Experiences"},{"inlineContent":[{"type":"text","text":"Felt provides several full screen experiences you can explicitly present. See the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenExperience"},{"type":"text","text":" "},{"code":"struct","type":"codeVoice"},{"type":"text","text":" for available options."}],"type":"paragraph"},{"code":["EmbeddedCare.shared.presentExperience(.splashScreen)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"User interaction with components can automatically present full screen experiences."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Alternately, you can explicitly present full screen experiences using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenViewController"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenView"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"UIKit","level":3,"anchor":"UIKit"},{"code":["let viewController = FullScreenViewController(experience: .pricingScreen)","viewController.modalPresentationStyle = .fullScreen","self.present(viewController, animated: true, completion: nil)","..."],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"SwiftUI","level":3,"anchor":"SwiftUI"},{"code":["struct MyView: View {","","    @State var shouldPresentEmbeddedCare = false","","    var body: some View {","        MyViewContent($shouldPresentEmbeddedCare)","            .fullScreenCover(isPresented: $shouldPresentEmbeddedCare) {","                FullScreenView(experience: .splashScreen)","            }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The SDK will automatically modally present full screen experiences in response to user actions such as tapping a component."}],"type":"paragraph"},{"type":"heading","text":"Feature Gating","level":2,"anchor":"Feature-Gating"},{"inlineContent":[{"type":"text","text":"You can check if a feature is enabled for the current user by calling "},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)"},{"type":"text","text":". See the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FeatureGate"},{"type":"text","text":" "},{"code":"enum","type":"codeVoice"},{"type":"text","text":" for available options."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, before displaying a component, you should call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)"},{"type":"text","text":" with the relevant feature gate to make sure the component should be displayed."}],"type":"paragraph"},{"code":["if EmbeddedCare.shared.checkFeatureGate(.globalRollout) {","    \/\/ View logic to display `ComponentView`","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Deep Linking","level":2,"anchor":"Deep-Linking"},{"inlineContent":[{"type":"text","text":"The SDK can handle certain deep-links to embedded care content through either urls or push notifications."},{"type":"text","text":" "},{"type":"text","text":"In your open-url and push notification handling code, call "},{"code":"EmbeddedCare\/handleURL(_:)","type":"codeVoice"},{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleNotification(_:)"},{"type":"text","text":" respectively to give the SDK an opportunity to respond to a deep-link event. Use "},{"code":"EmbeddedCare.shared.processStoredDeeplinks()","type":"codeVoice"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"the UI is in a stable state, to ensure that the latest deep links are called."}],"type":"paragraph"},{"type":"heading","text":"Compatiblity","level":2,"anchor":"Compatiblity"},{"inlineContent":[{"type":"text","text":"The SDK has minimum version requirements of Swift 5.5 and iOS 15."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"title":"Felt Embedded Care iOS SDK","role":"article","modules":[{"name":"FeltEmbeddedCare"}],"roleHeading":"Article"},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"pat