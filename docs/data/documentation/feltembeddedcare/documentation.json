{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Felt offers a seamless telehealth experience inside health apps. Our platform handles the full user lifecycle, including onboarding, payments, and doctor visits, ensuring a cohesive healthcare experience.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/feltembeddedcare\/documentation"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/feltembeddedcare\/documentation"]}],"kind":"article","sections":[],"identifier":{"url":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Documentation","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","title":"Felt Embedded Care iOS SDK","modules":[{"name":"FeltEmbeddedCare"}]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Initialization","text":"Initialization","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Primary interaction with the SDK is mediated through the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/shared"},{"type":"text","text":" singleton."}],"type":"paragraph"},{"inlineContent":[{"text":"At app launch, initialize the SDK with your SDK key using ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/initialize(sdkKey:)","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"UIKit","text":"UIKit","type":"heading","level":3},{"syntax":"swift","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","class AppDelegate: UIApplicationDelegate {","    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        Task {","            do {","                try await EmbeddedCare.shared.initalize(sdkKey: feltSDKKey)","                \/\/ Update any UI waiting on embedded care initialization","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","}"],"type":"codeListing"},{"anchor":"SwiftUI","text":"SwiftUI","type":"heading","level":3},{"syntax":"swift","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","@main","struct ClientApp: App {","","    @State var embeddedCareInitialized = false","","    init() {","        Task {","            do {","                try await EmbeddedCare.shared.initialize(sdkKey: sdkKey)","                embeddedCareInitialized = true","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","","}"],"type":"codeListing"},{"anchor":"User-Account-and-Patient-Details","text":"User Account and Patient Details","type":"heading","level":2},{"anchor":"Account","text":"Account","type":"heading","level":3},{"inlineContent":[{"text":"Once your app’s current user has been authenticated, provide their account details to the SDK using ","type":"text"},{"type":"codeVoice","code":"EmbeddedCare\/account"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let user = ...","EmbeddedCare.shared.account = Account(id: user.id, email: user.email)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When the user logs out, inform the SDK by setting ","type":"text"},{"code":"EmbeddedCare\/account","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["EmbeddedCare.shared.account = nil"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Selected Patient","anchor":"Selected-Patient","type":"heading"},{"inlineContent":[{"text":"The SDK considers the logged in person currently using your app to be a ","type":"text"},{"code":"patient","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Your user’s account may be the same person or a distinct person from the actual patient using your app."},{"type":"text","text":" "},{"type":"text","text":"For example, the account holder may be a parent and the patient may be their child."},{"type":"text","text":" "},{"type":"text","text":"Even if the account holder and patient represent the same person, take care to distinguish their ids"},{"type":"text","text":" "},{"type":"text","text":"if your app’s data model keeps them distinct."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Set the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Account\/selectedPatient","isActive":true},{"type":"text","text":" property to provide patient details to the SDK for the currently logged in patient."}],"type":"paragraph"},{"syntax":"swift","code":["let currentFamilyMember = ...","EmbeddedCare.shared.account?.selectedPatient = Patient(","    id: currentFamilyMember.id,","    relationshipToAccountHolder: .familyMember,","    email: currentFamilyMember.email,","    \/\/ Any custom information you want to provide","    custom: [\"notes\" : currentFamilyMember.notes]",")"],"type":"codeListing"},{"inlineContent":[{"text":"If any information changes about the account or the selected patient, just update ","type":"text"},{"code":"EmbeddedCare\/account","type":"codeVoice"},{"text":" with the latest information.","type":"text"}],"type":"paragraph"},{"text":"Component Experiences","anchor":"Component-Experiences","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"In order to integrate Felt embedded care content alongside your app’s native content, use "},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentView","isActive":true,"type":"reference"},{"type":"text","text":", a "},{"type":"codeVoice","code":"UIView"},{"type":"text","text":" subclass, or "},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Component","isActive":true,"type":"reference"},{"type":"text","text":", a "},{"type":"codeVoice","code":"SwiftUI"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentExperience"},{"text":" ","type":"text"},{"code":"enum","type":"codeVoice"},{"text":" for available options.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"UIKit","type":"heading","text":"UIKit"},{"syntax":"swift","type":"codeListing","code":["let componentView = ComponentView(experience: .dismissableCallToAction, custom: [:])","self.view.addSubview(componentView)","..."]},{"level":3,"anchor":"SwiftUI","type":"heading","text":"SwiftUI"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    var body: some View {","        Component(experience: .dismissableCallToAction, custom: [:])","    }","}"]},{"level":3,"anchor":"Layout","type":"heading","text":"Layout"},{"inlineContent":[{"type":"text","text":"Component contents may be loaded asynchronously, which means a component’s layout can change over time. A component determines its intrinsic height based on its current width."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both "},{"code":"UIKit","type":"codeVoice"},{"type":"text","text":" and "},{"code":"SwiftUI","type":"codeVoice"},{"type":"text","text":" components provide the ability to specify an "},{"code":"onHeightUpdated","type":"codeVoice"},{"type":"text","text":" handler that allows you to react to intrinsic height changes. For example, you can use this handler to animate layout changes."}],"type":"paragraph"},{"level":2,"anchor":"Full-Screen-Experiences","type":"heading","text":"Full Screen Experiences"},{"inlineContent":[{"type":"text","text":"Felt provides several full screen experiences you can explicitly present. See the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenExperience","isActive":true},{"type":"text","text":" "},{"code":"struct","type":"codeVoice"},{"type":"text","text":" for available options."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["EmbeddedCare.shared.presentExperience(.splashScreen)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"User interaction with components can automatically present full screen experiences."}]},{"type":"paragraph","inlineContent":[{"text":"Alternately, you can explicitly present full screen experiences using ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenViewController","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenView","type":"reference","isActive":true},{"text":".","type":"text"}]},{"anchor":"UIKit","type":"heading","level":3,"text":"UIKit"},{"code":["let viewController = FullScreenViewController(experience: .pricingScreen)","viewController.modalPresentationStyle = .fullScreen","self.present(viewController, animated: true, completion: nil)","..."],"type":"codeListing","syntax":"swift"},{"anchor":"SwiftUI","type":"heading","level":3,"text":"SwiftUI"},{"code":["struct MyView: View {","","    @State var shouldPresentEmbeddedCare = false","","    var body: some View {","        MyViewContent($shouldPresentEmbeddedCare)","            .fullScreenCover(isPresented: $shouldPresentEmbeddedCare) {","                FullScreenView(experience: .splashScreen)","            }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK will automatically modally present full screen experiences in response to user actions such as tapping a component."}]},{"anchor":"Feature-Gating","type":"heading","level":2,"text":"Feature Gating"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can check if a feature is enabled for the current user by calling "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true},{"type":"text","text":". See the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FeatureGate","isActive":true},{"type":"text","text":" "},{"type":"codeVoice","code":"enum"},{"type":"text","text":" for available options."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, before displaying a component, you should call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)"},{"type":"text","text":" with the relevant feature gate to make sure the component should be displayed."}]},{"code":["if EmbeddedCare.shared.checkFeatureGate(.globalRollout) {","    \/\/ View logic to display `ComponentView`","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Deep-Linking","type":"heading","level":2,"text":"Deep Linking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK can handle certain deep-links to embedded care content through either urls or push notifications."},{"type":"text","text":" "},{"type":"text","text":"In your open-url and push notification handling code, call "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleURL(_:)","isActive":true},{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"or "},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleNotification(_:)","type":"reference"},{"type":"text","text":" respectively to give the SDK an opportunity to respond to a deep-link event. Use "},{"code":"EmbeddedCare.shared.processStoredDeeplinks()","type":"codeVoice"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"the UI is in a stable state, to ensure that the latest deep links are called."}]},{"level":2,"anchor":"Compatiblity","type":"heading","text":"Compatiblity"},{"inlineContent":[{"text":"The SDK has minimum version requirements of Swift 5.5 and iOS 15.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare"]]},"references":{"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare":{"abstract":[],"kind":"symbol","url":"\/documentation\/feltembeddedcare","role":"collection","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare","type":"topic","title":"FeltEmbeddedCare"},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/Component":{"role":"symbol","abstract":[{"type":"text","text":"A "},{"code":"View","type":"codeVoice"},{"type":"text","text":" used to integrate Felt’s embedded care content alongside your app’s native "},{"code":"SwiftUI","type":"codeVoice"},{"type":"text","text":" content"}],"title":"Component","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Component","kind":"identifier"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"Component"}],"url":"\/documentation\/feltembeddedcare\/component","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Component","kind":"symbol"},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/EmbeddedCare/handleURL(_:)":{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleURL(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handleURL","kind":"identifier"},{"text":"(","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":") -> ","kind":"