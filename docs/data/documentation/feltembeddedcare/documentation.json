{"sections":[],"metadata":{"roleHeading":"Article","title":"Felt Embedded Care iOS SDK","modules":[{"name":"FeltEmbeddedCare"}],"role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/feltembeddedcare\/documentation"]},{"paths":["\/documentation\/feltembeddedcare\/documentation"],"traits":[{"interfaceLanguage":"occ"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Documentation"},"abstract":[{"type":"text","text":"Felt offers a seamless telehealth experience inside health apps. Our platform handles the full user lifecycle, including onboarding, payments, and doctor visits, ensuring a cohesive healthcare experience."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare"]]},"kind":"article","primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Initialization","anchor":"Initialization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary interaction with the SDK is mediated through the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/shared","isActive":true},{"type":"text","text":" singleton."}]},{"type":"paragraph","inlineContent":[{"text":"At app launch, initialize the SDK with your SDK key using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/initialize(sdkKey:)","type":"reference"},{"text":".","type":"text"}]},{"level":3,"type":"heading","text":"UIKit","anchor":"UIKit"},{"type":"codeListing","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","class AppDelegate: UIApplicationDelegate {","    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        Task {","            do {","                try await EmbeddedCare.shared.initalize(sdkKey: feltSDKKey)","                \/\/ Update any UI waiting on embedded care initialization","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","text":"SwiftUI","anchor":"SwiftUI"},{"type":"codeListing","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","@main","struct ClientApp: App {","","    @State var embeddedCareInitialized = false","","    init() {","        Task {","            do {","                try await EmbeddedCare.shared.initialize(sdkKey: sdkKey)","                embeddedCareInitialized = true","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","","}"],"syntax":"swift"},{"level":2,"type":"heading","text":"User Account and Patient Details","anchor":"User-Account-and-Patient-Details"},{"level":3,"type":"heading","text":"Account","anchor":"Account"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once your app’s current user has been authenticated, provide their account details to the SDK using "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/AuthManager\/account","isActive":true},{"type":"text","text":"."}]},{"code":["let user = ...","EmbeddedCare.shared.auth.account = Account(id: user.id, email: user.email)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user logs out, inform the SDK by setting "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/AuthManager\/account","isActive":true},{"type":"text","text":" to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]},{"code":["EmbeddedCare.shared.auth.account = nil"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"Selected Patient","anchor":"Selected-Patient"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK considers the logged in person currently using your app to be a "},{"code":"patient","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Your user’s account may be the same person or a distinct person from the actual patient using your app."},{"type":"text","text":" "},{"type":"text","text":"For example, the account holder may be a parent and the patient may be their child."},{"type":"text","text":" "},{"type":"text","text":"Even if the account holder and patient represent the same person, take care to distinguish their ids"},{"type":"text","text":" "},{"type":"text","text":"if your app’s data model keeps them distinct."}]},{"type":"paragraph","inlineContent":[{"text":"Set the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Account\/selectedPatient","type":"reference"},{"text":" property to provide patient details to the SDK for the currently logged in patient.","type":"text"}]},{"type":"codeListing","code":["let currentFamilyMember = ...","EmbeddedCare.shared.auth.account?.selectedPatient = Patient(","    id: currentFamilyMember.id,","    relationshipToAccountHolder: .familyMember,","    email: currentFamilyMember.email,","    \/\/ Any custom information you want to provide","    custom: [\"notes\" : currentFamilyMember.notes]",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If any information changes about the account or the selected patient, just update "},{"code":"EmbeddedCare\/account","type":"codeVoice"},{"type":"text","text":" with the latest information."}]},{"type":"heading","level":2,"text":"Component Experiences","anchor":"Component-Experiences"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In order to integrate Felt embedded care content alongside your app’s native content, use "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentView","isActive":true},{"type":"text","text":", a "},{"code":"UIView","type":"codeVoice"},{"type":"text","text":" subclass, or "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Component","isActive":true},{"type":"text","text":", a "},{"code":"SwiftUI","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentExperience","type":"reference"},{"text":" ","type":"text"},{"type":"codeVoice","code":"enum"},{"text":" for available options.","type":"text"}]},{"level":3,"type":"heading","text":"UIKit","anchor":"UIKit"},{"type":"codeListing","code":["let componentView = ComponentView(experience: .dismissableCallToAction, custom: [:])","self.view.addSubview(componentView)","..."],"syntax":"swift"},{"level":3,"type":"heading","text":"SwiftUI","anchor":"SwiftUI"},{"type":"codeListing","code":["struct MyView: View {","    var body: some View {","        Component(experience: .dismissableCallToAction, custom: [:])","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","text":"Layout","anchor":"Layout"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Component contents may be loaded asynchronously, which means a component’s layout can change over time. A component determines its intrinsic height based on its current width."}]},{"type":"paragraph","inlineContent":[{"text":"Both ","type":"text"},{"type":"codeVoice","code":"UIKit"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"SwiftUI"},{"text":" components provide the ability to specify an ","type":"text"},{"type":"codeVoice","code":"onHeightUpdated"},{"text":" handler that allows you to react to intrinsic height changes. For example, you can use this handler to animate layout changes.","type":"text"}]},{"level":2,"type":"heading","text":"Full Screen Experiences","anchor":"Full-Screen-Experiences"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Felt provides several full screen experiences you can explicitly present. See the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenExperience","isActive":true},{"type":"text","text":" "},{"code":"struct","type":"codeVoice"},{"type":"text","text":" for available options."}]},{"code":["EmbeddedCare.shared.presentExperience(.splashScreen)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"User interaction with components can automatically present full screen experiences."}]},{"type":"paragraph","inlineContent":[{"text":"Alternately, you can explicitly present full screen experiences using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenViewController","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenView","type":"reference"},{"text":".","type":"text"}]},{"level":3,"type":"heading","text":"UIKit","anchor":"UIKit"},{"type":"codeListing","code":["let viewController = FullScreenViewController(experience: .pricingScreen)","viewController.modalPresentationStyle = .fullScreen","self.present(viewController, animated: true, completion: nil)","..."],"syntax":"swift"},{"level":3,"type":"heading","text":"SwiftUI","anchor":"SwiftUI"},{"type":"codeListing","code":["struct MyView: View {","","    @State var shouldPresentEmbeddedCare = false","","    var body: some View {","        MyViewContent($shouldPresentEmbeddedCare)","            .fullScreenCover(isPresented: $shouldPresentEmbeddedCare) {","                FullScreenView(experience: .splashScreen)","            }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK will automatically modally present full screen experiences in response to user actions such as tapping a component."}]},{"type":"heading","level":2,"text":"Feature Gating","anchor":"Feature-Gating"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can check if a feature is enabled for the current user by calling "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true},{"type":"text","text":". See the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FeatureGate","isActive":true},{"type":"text","text":" "},{"code":"enum","type":"codeVoice"},{"type":"text","text":" for available options."}]},{"type":"paragraph","inlineContent":[{"text":"For example, before displaying a component, you should call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","type":"reference"},{"text":" with the relevant feature gate to make sure the component should be displayed.","type":"text"}]},{"type":"codeListing","code":["if EmbeddedCare.shared.checkFeatureGate(.globalRollout) {","    \/\/ View logic to display `ComponentView`","}"],"syntax":"swift"},{"level":2,"type":"heading","text":"Deep Linking","anchor":"Deep-Linking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK can handle certain deep-links to embedded care content through either urls or push notifications."},{"type":"text","text":" "},{"type":"text","text":"In your open-url and push notification handling code, call "},{"code":"EmbeddedCare\/handleURL(_:)","type":"codeVoice"},{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleNotification(_:)","isActive":true},{"type":"text","text":" respectively to give the SDK an opportunity to respond to a deep-link event. Use "},{"code":"EmbeddedCare.shared.processStoredDeeplinks()","type":"codeVoice"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"the UI is in a stable state, to ensure that the latest deep links are called."}]},{"type":"heading","level":2,"text":"Compatiblity","anchor":"Compatiblity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK has minimum version requirements of Swift 5.5 and iOS 15."}]}],"kind":"content"}],"references":{"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/EmbeddedCare/initialize(sdkKey:)":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"initialize","kind":"identifier"},{"text":"(","kind":"text"},{"text":"sdkKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"url":"\/documentation\/feltembeddedcare\/embeddedcare\/initialize(sdkkey:)","type":"topic","title":"initialize(sdkKey:)","abstract":[{"type":"text","text":"Initialize the SDK with your SDK key. Must be called before accessing EmbeddedCare.shared"}],"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/initialize(sdkKey:)","kind":"symbol","role":"symbol"},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/Account/selectedPatient":{"url":"\/documentation\/feltembeddedcare\/account\/selectedpatient","kind":"symbol","abstract":[{"type":"text","text":"Represents information about the currently selected patient on the account."},{"type":"text","text":" "},{"type":"text","text":"Update this as information about the curren