{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"FeltEmbeddedCare"}],"roleHeading":"Article","role":"article","title":"Felt Embedded Care iOS SDK"},"kind":"article","abstract":[{"text":"Felt offers a seamless telehealth experience inside health apps. Our platform handles the full user lifecycle, including onboarding, payments, and doctor visits, ensuring a cohesive healthcare experience.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Initialization","type":"heading","level":2,"anchor":"Initialization"},{"inlineContent":[{"type":"text","text":"Primary interaction with the SDK is mediated through the "},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/shared","type":"reference","isActive":true},{"type":"text","text":" singleton."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"At app launch, initialize the SDK with your SDK key using "},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/initialize(sdkKey:)","type":"reference"},{"type":"text","text":"."}]},{"text":"UIKit","type":"heading","level":3,"anchor":"UIKit"},{"syntax":"swift","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","class AppDelegate: UIApplicationDelegate {","    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        Task {","            do {","                try await EmbeddedCare.shared.initalize(sdkKey: feltSDKKey)","                \/\/ Update any UI waiting on embedded care initialization","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","}"],"type":"codeListing"},{"text":"SwiftUI","type":"heading","level":3,"anchor":"SwiftUI"},{"syntax":"swift","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","@main","struct ClientApp: App {","","    @State var embeddedCareInitialized = false","","    init() {","        Task {","            do {","                try await EmbeddedCare.shared.initialize(sdkKey: sdkKey)","                embeddedCareInitialized = true","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","","}"],"type":"codeListing"},{"text":"User Account and Patient Details","type":"heading","level":2,"anchor":"User-Account-and-Patient-Details"},{"text":"Account","type":"heading","level":3,"anchor":"Account"},{"inlineContent":[{"text":"Once your app’s current user has been authenticated, provide their account details to the SDK using ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/AuthManager\/account","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let user = ...","EmbeddedCare.shared.auth.account = Account(id: user.id, email: user.email)"],"type":"codeListing"},{"inlineContent":[{"text":"When the user logs out, inform the SDK by setting ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/AuthManager\/account","isActive":true},{"text":" to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["EmbeddedCare.shared.auth.account = nil"],"type":"codeListing"},{"text":"Selected Patient","type":"heading","level":3,"anchor":"Selected-Patient"},{"inlineContent":[{"text":"The SDK considers the logged in person currently using your app to be a ","type":"text"},{"type":"codeVoice","code":"patient"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Your user’s account may be the same person or a distinct person from the actual patient using your app.","type":"text"},{"text":" ","type":"text"},{"text":"For example, the account holder may be a parent and the patient may be their child.","type":"text"},{"text":" ","type":"text"},{"text":"Even if the account holder and patient represent the same person, take care to distinguish their ids","type":"text"},{"text":" ","type":"text"},{"text":"if your app’s data model keeps them distinct.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Set the ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Account\/selectedPatient","isActive":true},{"text":" property to provide patient details to the SDK for the currently logged in patient.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let currentFamilyMember = ...","EmbeddedCare.shared.auth.account?.selectedPatient = Patient(","    id: currentFamilyMember.id,","    relationshipToAccountHolder: .familyMember,","    email: currentFamilyMember.email,","    \/\/ Any custom information you want to provide","    custom: [\"notes\" : currentFamilyMember.notes]",")"],"type":"codeListing"},{"inlineContent":[{"text":"If any information changes about the account or the selected patient, just update ","type":"text"},{"type":"codeVoice","code":"EmbeddedCare\/account"},{"text":" with the latest information.","type":"text"}],"type":"paragraph"},{"text":"Component Experiences","type":"heading","level":2,"anchor":"Component-Experiences"},{"inlineContent":[{"text":"In order to integrate Felt embedded care content alongside your app’s native content, use ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentView","isActive":true},{"text":", a ","type":"text"},{"type":"codeVoice","code":"UIView"},{"text":" subclass, or ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Component","isActive":true},{"text":", a ","type":"text"},{"type":"codeVoice","code":"SwiftUI"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See the ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentExperience","isActive":true},{"text":" ","type":"text"},{"type":"codeVoice","code":"enum"},{"text":" for available options.","type":"text"}],"type":"paragraph"},{"text":"UIKit","type":"heading","level":3,"anchor":"UIKit"},{"syntax":"swift","code":["let componentView = ComponentView(experience: .dismissableCallToAction, custom: [:])","self.view.addSubview(componentView)","..."],"type":"codeListing"},{"text":"SwiftUI","type":"heading","level":3,"anchor":"SwiftUI"},{"syntax":"swift","code":["struct MyView: View {","    var body: some View {","        Component(experience: .dismissableCallToAction, custom: [:])","    }","}"],"type":"codeListing"},{"text":"Layout","type":"heading","level":3,"anchor":"Layout"},{"inlineContent":[{"text":"Component contents may be loaded asynchronously, which means a component’s layout can change over time. A component determines its intrinsic height based on its current width.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Both ","type":"text"},{"type":"codeVoice","code":"UIKit"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"SwiftUI"},{"text":" components provide the ability to specify an ","type":"text"},{"type":"codeVoice","code":"onHeightUpdated"},{"text":" handler that allows you to react to intrinsic height changes. For example, you can use this handler to animate layout changes.","type":"text"}],"type":"paragraph"},{"text":"Full Screen Experiences","type":"heading","level":2,"anchor":"Full-Screen-Experiences"},{"inlineContent":[{"text":"Felt provides several full screen experiences you can explicitly present. See the ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenExperience","isActive":true},{"text":" ","type":"text"},{"type":"codeVoice","code":"struct"},{"text":" for available options.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["EmbeddedCare.shared.presentExperience(.splashScreen)"],"type":"codeListing"},{"inlineContent":[{"text":"User interaction with components can automatically present full screen experiences.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Alternately, you can explicitly present full screen experiences using ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenViewController","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenView","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"text":"UIKit","type":"heading","level":3,"anchor":"UIKit"},{"syntax":"swift","code":["let viewController = FullScreenViewController(experience: .pricingScreen)","viewController.modalPresentationStyle = .fullScreen","self.present(viewController, animated: true, completion: nil)","..."],"type":"codeListing"},{"text":"SwiftUI","type":"heading","level":3,"anchor":"SwiftUI"},{"syntax":"swift","code":["struct MyView: View {","","    @State var shouldPresentEmbeddedCare = false","","    var body: some View {","        MyViewContent($shouldPresentEmbeddedCare)","            .fullScreenCover(isPresented: $shouldPresentEmbeddedCare) {","                FullScreenView(experience: .splashScreen)","            }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The SDK will automatically modally present full screen experiences in response to user actions such as tapping a component.","type":"text"}],"type":"paragraph"},{"text":"Feature Gating","type":"heading","level":2,"anchor":"Feature-Gating"},{"inlineContent":[{"text":"You can check if a feature is enabled for the current user by calling ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true},{"text":". See the ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FeatureGate","isActive":true},{"text":" ","type":"text"},{"type":"codeVoice","code":"enum"},{"text":" for available options.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, before displaying a component, you should call ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true},{"text":" with the relevant feature gate to make sure the component should be displayed.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["if EmbeddedCare.shared.checkFeatureGate(.globalRollout) {","    \/\/ View logic to display `ComponentView`","}"],"type":"codeListing"},{"text":"Deep Linking","type":"heading","level":2,"anchor":"Deep-Linking"},{"inlineContent":[{"text":"The SDK can handle certain deep-links to embedded care content through either urls or push notifications.","type":"text"},{"text":" ","type":"text"},{"text":"In your open-url and push notification handling code, call ","type":"text"},{"type":"codeVoice","code":"EmbeddedCare\/handleURL(_:)"},{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleNotification(_:)","isActive":true},{"text":" respectively to give the SDK an opportunity to respond to a deep-link event. Use ","type":"text"},{"type":"codeVoice","code":"EmbeddedCare.shared.processStoredDeeplinks()"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"text":"the UI is in a stable state, to ensure that the latest deep links are called.","type":"text"}],"type":"paragraph"},{"text":"Compatiblity","type":"heading","level":2,"anchor":"Compatiblity"},{"inlineContent":[{"text":"The SDK has minimum version requirements of Swift 5.5 and iOS 15.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/feltembeddedcare\/documentation"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/feltembeddedcare\/documentation"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare"]]},"identifier":{"url":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Documentation","interfaceLanguage":"swift"},"references":{"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/FullScreenViewController":{"kind":"symbol","type":"topic","url":"\/documentation\/feltembeddedcare\/fullscreenviewcontroller","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenViewController","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FullScreenViewController","kind":"identifier"}],"title":"FullScreenViewController","navigatorTitle":[{"text":"FullScreenViewController","kind":"identifier"}],"abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"UIViewController"},{"text":" used to integrate Felt’s embedded care content.","type":"text"},{"text":" ","type":"text"},{"text":"The view controller is meant to be presented modally or in a way that takes up the majority of your app’s UI,","type":"text"},{"text":" ","type":"text"},{"text":"such as a tab in a tab bar.","type":"text"}]},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/ComponentExperience":{"navigatorTitle":[{"kind":"identifier","text":"ComponentExperience"}],"abstract":[{"text":"An experience associated with a component view that is displayed alongside","type":"text"},{"text":" ","type":"text"},{"text":"your app’s native content","type":"text"}],"kind":"symbol","role":"symbol","title