{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Felt offers a seamless telehealth experience inside health apps. Our platform handles the full user lifecycle, including onboarding, payments, and doctor visits, ensuring a cohesive healthcare experience.","type":"text"}],"metadata":{"role":"article","modules":[{"name":"FeltEmbeddedCare"}],"title":"Felt Embedded Care iOS SDK","roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Documentation"},"kind":"article","variants":[{"paths":["\/documentation\/feltembeddedcare\/documentation"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/feltembeddedcare\/documentation"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Initialization","anchor":"Initialization","type":"heading"},{"inlineContent":[{"text":"Primary interaction with the SDK is mediated through the ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/shared","isActive":true,"type":"reference"},{"text":" singleton.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"At app launch, initialize the SDK with your SDK key using ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/initialize(sdkKey:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"UIKit","anchor":"UIKit","type":"heading"},{"code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","class AppDelegate: UIApplicationDelegate {","    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        Task {","            do {","                try await EmbeddedCare.shared.initalize(sdkKey: feltSDKKey)","                \/\/ Update any UI waiting on embedded care initialization","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"SwiftUI","anchor":"SwiftUI","type":"heading"},{"code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","@main","struct ClientApp: App {","","    @State var embeddedCareInitialized = false","","    init() {","        Task {","            do {","                try await EmbeddedCare.shared.initialize(sdkKey: sdkKey)","                embeddedCareInitialized = true","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"User Account and Patient Details","anchor":"User-Account-and-Patient-Details","type":"heading"},{"level":3,"text":"Account","anchor":"Account","type":"heading"},{"inlineContent":[{"text":"Once your app’s current user has been authenticated, provide their account details to the SDK using ","type":"text"},{"code":"EmbeddedCare\/account","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["let user = ...","EmbeddedCare.shared.account = Account(id: user.id, email: user.email)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When the user logs out, inform the SDK by setting ","type":"text"},{"code":"EmbeddedCare\/account","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["EmbeddedCare.shared.account = nil"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Selected Patient","anchor":"Selected-Patient","type":"heading"},{"inlineContent":[{"text":"The SDK considers the logged in person currently using your app to be a ","type":"text"},{"code":"patient","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Your user’s account may be the same person or a distinct person from the actual patient using your app.","type":"text"},{"text":" ","type":"text"},{"text":"For example, the account holder may be a parent and the patient may be their child.","type":"text"},{"text":" ","type":"text"},{"text":"Even if the account holder and patient represent the same person, take care to distinguish their ids","type":"text"},{"text":" ","type":"text"},{"text":"if your app’s data model keeps them distinct.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Set the ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Account\/selectedPatient","isActive":true,"type":"reference"},{"text":" property to provide patient details to the SDK for the currently logged in patient.","type":"text"}],"type":"paragraph"},{"code":["let currentFamilyMember = ...","EmbeddedCare.shared.account?.selectedPatient = Patient(","    id: currentFamilyMember.id,","    relationshipToAccountHolder: .familyMember,","    email: currentFamilyMember.email,","    \/\/ Any custom information you want to provide","    custom: [\"notes\" : currentFamilyMember.notes]",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"If any information changes about the account or the selected patient, just update ","type":"text"},{"code":"EmbeddedCare\/account","type":"codeVoice"},{"text":" with the latest information.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Component Experiences","anchor":"Component-Experiences","type":"heading"},{"inlineContent":[{"text":"In order to integrate Felt embedded care content alongside your app’s native content, use ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentView","isActive":true,"type":"reference"},{"text":", a ","type":"text"},{"code":"UIView","type":"codeVoice"},{"text":" subclass, or ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Component","isActive":true,"type":"reference"},{"text":", a ","type":"text"},{"code":"SwiftUI","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See the ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentExperience","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"code":"enum","type":"codeVoice"},{"text":" for available options.","type":"text"}],"type":"paragraph"},{"level":3,"text":"UIKit","anchor":"UIKit","type":"heading"},{"code":["let componentView = ComponentView(experience: .dismissableCallToAction, custom: [:])","self.view.addSubview(componentView)","..."],"type":"codeListing","syntax":"swift"},{"level":3,"text":"SwiftUI","anchor":"SwiftUI","type":"heading"},{"code":["struct MyView: View {","    var body: some View {","        Component(experience: .dismissableCallToAction, custom: [:])","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Layout","anchor":"Layout","type":"heading"},{"inlineContent":[{"text":"Component contents may be loaded asynchronously, which means a component’s layout can change over time. A component determines its intrinsic height based on its current width.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Both ","type":"text"},{"code":"UIKit","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"SwiftUI","type":"codeVoice"},{"text":" components provide the ability to specify an ","type":"text"},{"code":"onHeightUpdated","type":"codeVoice"},{"text":" handler that allows you to react to intrinsic height changes. For example, you can use this handler to animate layout changes.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Full Screen Experiences","anchor":"Full-Screen-Experiences","type":"heading"},{"inlineContent":[{"text":"Felt provides several full screen experiences you can explicitly present. See the ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenExperience","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"code":"struct","type":"codeVoice"},{"text":" for available options.","type":"text"}],"type":"paragraph"},{"code":["EmbeddedCare.shared.presentExperience(.splashScreen)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"User interaction with components can automatically present full screen experiences.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Alternately, you can explicitly present full screen experiences using ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenViewController","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenView","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"UIKit","anchor":"UIKit","type":"heading"},{"code":["let viewController = FullScreenViewController(experience: .pricingScreen)","viewController.modalPresentationStyle = .fullScreen","self.present(viewController, animated: true, completion: nil)","..."],"type":"codeListing","syntax":"swift"},{"level":3,"text":"SwiftUI","anchor":"SwiftUI","type":"heading"},{"code":["struct MyView: View {","","    @State var shouldPresentEmbeddedCare = false","","    var body: some View {","        MyViewContent($shouldPresentEmbeddedCare)","            .fullScreenCover(isPresented: $shouldPresentEmbeddedCare) {","                FullScreenView(experience: .splashScreen)","            }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The SDK will automatically modally present full screen experiences in response to user actions such as tapping a component.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Feature Gating","anchor":"Feature-Gating","type":"heading"},{"inlineContent":[{"text":"You can check if a feature is enabled for the current user by calling ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true,"type":"reference"},{"text":". See the ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FeatureGate","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"code":"enum","type":"codeVoice"},{"text":" for available options.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, before displaying a component, you should call ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true,"type":"reference"},{"text":" with the relevant feature gate to make sure the component should be displayed.","type":"text"}],"type":"paragraph"},{"code":["if EmbeddedCare.shared.checkFeatureGate(.globalRollout) {","    \/\/ View logic to display `ComponentView`","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Deep Linking","anchor":"Deep-Linking","type":"heading"},{"inlineContent":[{"text":"The SDK can handle certain deep-links to embedded care content through either urls or push notifications.","type":"text"},{"text":" ","type":"text"},{"text":"In your open-url and push notification handling code, call ","type":"text"},{"code":"EmbeddedCare\/handleURL(_:)","type":"codeVoice"},{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleNotification(_:)","isActive":true,"type":"reference"},{"text":" respectively to give the SDK an opportunity to respond to a deep-link event. Use ","type":"text"},{"code":"EmbeddedCare.shared.processStoredDeeplinks()","type":"codeVoice"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"text":"the UI is in a stable state, to ensure that the latest deep links are called.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Compatiblity","anchor":"Compatiblity","type":"heading"},{"inlineContent":[{"text":"The SDK has minimum version requirements of Swift 5.5 and iOS 15.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare"]]},"references":{"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/FeatureGate":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"FeatureGate"}],"type":"topic","abstract":[{"type":"text","text":"An enumeration of known features that can be checked for the current account"}],"kind":"symbol","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FeatureGate","url":"\/documentation\/feltembeddedcare\/featuregate","title":"FeatureGate","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"FeatureGate"}]},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/FullScreenView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FullScreenView","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenView","kind":"symbol","abstract":[{"type":"text","text":"A "},{"code":"SwiftUI","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":" used to integrate Felt’s embedded care content."},{"type":"text","text":" "},{"type":"text","text":"The view is meant to be presented modally or in a way that takes up the majority of your app’s UI,"},{"type":"text","text":" "},{"type":"text","text":"such as a tab in a tab bar."}],"url":"\/documentation\/feltembeddedcare\/fullscreenview","title":"FullScreenView","role":"symbol","navigatorTitle":[{"text":"FullScreenView","kind":"identifier"}]},"d