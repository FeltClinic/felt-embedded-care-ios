{"primaryContentSections":[{"content":[{"anchor":"Initialization","text":"Initialization","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary interaction with the SDK is mediated through the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/shared","isActive":true},{"type":"text","text":" singleton."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"At app launch, initialize the SDK with your SDK key using "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/initialize(sdkKey:)","isActive":true},{"type":"text","text":"."}]},{"anchor":"UIKit","text":"UIKit","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","class AppDelegate: UIApplicationDelegate {","    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        Task {","            do {","                try await EmbeddedCare.shared.initalize(sdkKey: feltSDKKey)","                \/\/ Update any UI waiting on embedded care initialization","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","}"]},{"anchor":"SwiftUI","text":"SwiftUI","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","@main","struct ClientApp: App {","","    @State var embeddedCareInitialized = false","","    init() {","        Task {","            do {","                try await EmbeddedCare.shared.initialize(sdkKey: sdkKey)","                embeddedCareInitialized = true","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","","}"]},{"anchor":"User-Account-and-Patient-Details","text":"User Account and Patient Details","type":"heading","level":2},{"anchor":"Account","text":"Account","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once your app’s current user has been authenticated, provide their account details to the SDK using "},{"code":"EmbeddedCare\/account","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let user = ...","EmbeddedCare.shared.account = Account(id: user.id, email: user.email)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user logs out, inform the SDK by setting "},{"code":"EmbeddedCare\/account","type":"codeVoice"},{"type":"text","text":" to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["EmbeddedCare.shared.account = nil"]},{"anchor":"Selected-Patient","text":"Selected Patient","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK considers the logged in person currently using your app to be a "},{"code":"patient","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Your user’s account may be the same person or a distinct person from the actual patient using your app."},{"type":"text","text":" "},{"type":"text","text":"For example, the account holder may be a parent and the patient may be their child."},{"type":"text","text":" "},{"type":"text","text":"Even if the account holder and patient represent the same person, take care to distinguish their ids"},{"type":"text","text":" "},{"type":"text","text":"if your app’s data model keeps them distinct."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Account\/selectedPatient","isActive":true},{"type":"text","text":" property to provide patient details to the SDK for the currently logged in patient."}]},{"type":"codeListing","syntax":"swift","code":["let currentFamilyMember = ...","EmbeddedCare.shared.account?.selectedPatient = Patient(","    id: currentFamilyMember.id,","    relationshipToAccountHolder: .familyMember,","    email: currentFamilyMember.email,","    \/\/ Any custom information you want to provide","    custom: [\"notes\" : currentFamilyMember.notes]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If any information changes about the account or the selected patient, just update "},{"code":"EmbeddedCare\/account","type":"codeVoice"},{"type":"text","text":" with the latest information."}]},{"anchor":"Component-Experiences","text":"Component Experiences","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In order to integrate Felt embedded care content alongside your app’s native content, use "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentView","isActive":true},{"type":"text","text":", a "},{"code":"UIView","type":"codeVoice"},{"type":"text","text":" subclass, or "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Component","isActive":true},{"type":"text","text":", a "},{"code":"SwiftUI","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentExperience","isActive":true},{"type":"text","text":" "},{"code":"enum","type":"codeVoice"},{"type":"text","text":" for available options."}]},{"anchor":"UIKit","text":"UIKit","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["let componentView = ComponentView(experience: .dismissableCallToAction, custom: [:])","self.view.addSubview(componentView)","..."]},{"anchor":"SwiftUI","text":"SwiftUI","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    var body: some View {","        Component(experience: .dismissableCallToAction, custom: [:])","    }","}"]},{"anchor":"Layout","text":"Layout","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Component contents may be loaded asynchronously, which means a component’s layout can change over time. A component determines its intrinsic height based on its current width."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"code":"UIKit","type":"codeVoice"},{"type":"text","text":" and "},{"code":"SwiftUI","type":"codeVoice"},{"type":"text","text":" components provide the ability to specify an "},{"code":"onHeightUpdated","type":"codeVoice"},{"type":"text","text":" handler that allows you to react to intrinsic height changes. For example, you can use this handler to animate layout changes."}]},{"anchor":"Full-Screen-Experiences","text":"Full Screen Experiences","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Felt provides several full screen experiences you can explicitly present. See the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenExperience","isActive":true},{"type":"text","text":" "},{"code":"struct","type":"codeVoice"},{"type":"text","text":" for available options."}]},{"type":"codeListing","syntax":"swift","code":["EmbeddedCare.shared.presentExperience(.splashScreen)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"User interaction with components can automatically present full screen experiences."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternately, you can explicitly present full screen experiences using "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenViewController","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenView","isActive":true},{"type":"text","text":"."}]},{"anchor":"UIKit","text":"UIKit","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["let viewController = FullScreenViewController(experience: .pricingScreen)","viewController.modalPresentationStyle = .fullScreen","self.present(viewController, animated: true, completion: nil)","..."]},{"anchor":"SwiftUI","text":"SwiftUI","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","","    @State var shouldPresentEmbeddedCare = false","","    var body: some View {","        MyViewContent($shouldPresentEmbeddedCare)","            .fullScreenCover(isPresented: $shouldPresentEmbeddedCare) {","                FullScreenView(experience: .splashScreen)","            }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK will automatically modally present full screen experiences in response to user actions such as tapping a component."}]},{"anchor":"Feature-Gating","text":"Feature Gating","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can check if a feature is enabled for the current user by calling "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true},{"type":"text","text":". See the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FeatureGate","isActive":true},{"type":"text","text":" "},{"code":"enum","type":"codeVoice"},{"type":"text","text":" for available options."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, before displaying a component, you should call "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true},{"type":"text","text":" with the relevant feature gate to make sure the component should be displayed."}]},{"type":"codeListing","syntax":"swift","code":["if EmbeddedCare.shared.checkFeatureGate(.globalRollout) {","    \/\/ View logic to display `ComponentView`","}"]},{"anchor":"Deep-Linking","text":"Deep Linking","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK can handle certain deep-links to embedded care content through either urls or push notifications."},{"type":"text","text":" "},{"type":"text","text":"In your open-url and push notification handling code, call "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleURL(_:)","isActive":true},{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleNotification(_:)","isActive":true},{"type":"text","text":" respectively to give the SDK an opportunity to respond to a deep-link event. Use "},{"code":"EmbeddedCare.shared.processStoredDeeplinks()","type":"codeVoice"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"the UI is in a stable state, to ensure that the latest deep links are called."}]},{"anchor":"Compatiblity","text":"Compatiblity","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK has minimum version requirements of Swift 5.5 and iOS 15."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"text":"Felt offers a seamless telehealth experience inside health apps. Our platform handles the full user lifecycle, including onboarding, payments, and doctor visits, ensuring a cohesive healthcare experience.","type":"text"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/feltembeddedcare\/documentation"]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/feltembeddedcare\/documentation"]}],"hierarchy":{"paths":[["doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare"]]},"metadata":{"role":"article","modules":[{"name":"FeltEmbeddedCare"}],"title":"Felt Embedded Care iOS SDK","roleHeading":"Article"},"identifier":{"url":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Documentation","interfaceLanguage":"swift"},"references":{"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/FullScreenView":{"type":"topic","navigatorTitle":[{"text":"FullScreenView","kind":"identifier"}],"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenView","url":"\/documentation\/feltembeddedcare\/fullscreenview","title":"FullScreenView","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FullScreenView","kind":"identifier"}],"abstract":[{"type":"text","text":"A "},{"code":"SwiftUI","type":"codeVoice"},{"type":"text","text":" "},{"code":"View","type":"codeVoice"},{"type":"text","text":" used to integrate Felt’s embedded care content."},{"type":"text","text":" "},{"type":"text","text":"The view is meant to be presented modally or in a way that takes up the majority of your app’s UI,"},{"type":"text","text":" "},{"type":"text","text":"such as a tab in a tab bar."}]},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/EmbeddedCare/handleURL(_:)":{"type":"topic","url":"\/documentation\/feltembeddedcare\/embeddedcare\/handleurl(_:)","abstract":[],"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"handleURL","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:10Foundation3URLV","text":"URL","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleURL(_:)","title":"handleURL(_:)"},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/EmbeddedCare/checkFeatureGate(_:)":{"url":"\/documentation\/feltembeddedcare\/embeddedcare\/checkfeaturegate(_:)","role":"symbol","abstract":[{"type":"text","text":"Check whether the specified feature gate is enabled for the current user."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","title":"checkFeatureGate(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkFeatureGate"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"FeatureGate","preciseIdentifier":"s:16FeltEmbeddedCare11FeatureGateO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/EmbeddedCare/handleNotification(_:)":{"url":"\/documentation\/feltembeddedcare\/embeddedcare\/handlenotification(_:)","kind":"symbol","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleNotification(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handleNotification"},{"kind":"text","text":"("},{"preciseIdentifier":"c:objc(cs)UNNotification","kind":"typeIdentifier","text":"UNNotification"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"title":"handleNotification(_:)","type":"topic","abstract":[],"role":"symbol"},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/FeatureGate":{"url":"\/documentation\/feltembeddedcare\/featuregate","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"FeatureGate"}],"abstract":[{"type":"text","text":"A