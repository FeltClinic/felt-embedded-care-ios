{"kind":"article","abstract":[{"type":"text","text":"Felt offers a seamless telehealth experience inside health apps. Our platform handles the full user lifecycle, including onboarding, payments, and doctor visits, ensuring a cohesive healthcare experience."}],"variants":[{"paths":["\/documentation\/feltembeddedcare\/documentation"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/feltembeddedcare\/documentation"],"traits":[{"interfaceLanguage":"occ"}]}],"sections":[],"identifier":{"url":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Documentation","interfaceLanguage":"swift"},"metadata":{"title":"Felt Embedded Care iOS SDK","roleHeading":"Article","role":"article","modules":[{"name":"FeltEmbeddedCare"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Initialization","type":"heading","level":2,"anchor":"Initialization"},{"inlineContent":[{"text":"Primary interaction with the SDK is mediated through the ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/shared","isActive":true},{"type":"text","text":" singleton."}],"type":"paragraph"},{"inlineContent":[{"text":"At app launch, initialize the SDK with your SDK key using ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/initialize(sdkKey:)","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"UIKit","text":"UIKit"},{"code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","class AppDelegate: UIApplicationDelegate {","    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        Task {","            do {","                try await EmbeddedCare.shared.initalize(sdkKey: feltSDKKey)","                \/\/ Update any UI waiting on embedded care initialization","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"SwiftUI","type":"heading","anchor":"SwiftUI","level":3},{"type":"codeListing","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","@main","struct ClientApp: App {","","    @State var embeddedCareInitialized = false","","    init() {","        Task {","            do {","                try await EmbeddedCare.shared.initialize(sdkKey: sdkKey)","                embeddedCareInitialized = true","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","","}"],"syntax":"swift"},{"anchor":"User-Account-and-Patient-Details","text":"User Account and Patient Details","type":"heading","level":2},{"anchor":"Account","text":"Account","type":"heading","level":3},{"inlineContent":[{"text":"Once your app’s current user has been authenticated, provide their account details to the SDK using ","type":"text"},{"type":"codeVoice","code":"EmbeddedCare\/account"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let user = ...","EmbeddedCare.shared.account = Account(id: user.id, email: user.email)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user logs out, inform the SDK by setting "},{"code":"EmbeddedCare\/account","type":"codeVoice"},{"type":"text","text":" to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["EmbeddedCare.shared.account = nil"]},{"text":"Selected Patient","type":"heading","anchor":"Selected-Patient","level":3},{"inlineContent":[{"text":"The SDK considers the logged in person currently using your app to be a ","type":"text"},{"code":"patient","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Your user’s account may be the same person or a distinct person from the actual patient using your app.","type":"text"},{"text":" ","type":"text"},{"text":"For example, the account holder may be a parent and the patient may be their child.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Even if the account holder and patient represent the same person, take care to distinguish their ids"},{"type":"text","text":" "},{"type":"text","text":"if your app’s data model keeps them distinct."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Set the "},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Account\/selectedPatient","isActive":true,"type":"reference"},{"type":"text","text":" property to provide patient details to the SDK for the currently logged in patient."}],"type":"paragraph"},{"code":["let currentFamilyMember = ...","EmbeddedCare.shared.account?.selectedPatient = Patient(","    id: currentFamilyMember.id,","    relationshipToAccountHolder: .familyMember,","    email: currentFamilyMember.email,","    \/\/ Any custom information you want to provide","    custom: [\"notes\" : currentFamilyMember.notes]",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"If any information changes about the account or the selected patient, just update "},{"type":"codeVoice","code":"EmbeddedCare\/account"},{"type":"text","text":" with the latest information."}],"type":"paragraph"},{"text":"Component Experiences","level":2,"anchor":"Component-Experiences","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In order to integrate Felt embedded care content alongside your app’s native content, use ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentView","type":"reference","isActive":true},{"type":"text","text":", a "},{"type":"codeVoice","code":"UIView"},{"type":"text","text":" subclass, or "},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Component","type":"reference","isActive":true},{"type":"text","text":", a "},{"type":"codeVoice","code":"SwiftUI"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentExperience"},{"text":" ","type":"text"},{"code":"enum","type":"codeVoice"},{"text":" for available options.","type":"text"}]},{"text":"UIKit","type":"heading","level":3,"anchor":"UIKit"},{"code":["let componentView = ComponentView(experience: .dismissableCallToAction, custom: [:])","self.view.addSubview(componentView)","..."],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"SwiftUI","text":"SwiftUI"},{"code":["struct MyView: View {","    var body: some View {","        Component(experience: .dismissableCallToAction, custom: [:])","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"Layout","text":"Layout"},{"inlineContent":[{"type":"text","text":"Component contents may be loaded asynchronously, which means a component’s layout can change over time. A component determines its intrinsic height based on its current width."}],"type":"paragraph"},{"inlineContent":[{"text":"Both ","type":"text"},{"type":"codeVoice","code":"UIKit"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"SwiftUI"},{"text":" components provide the ability to specify an ","type":"text"},{"type":"codeVoice","code":"onHeightUpdated"},{"text":" handler that allows you to react to intrinsic height changes. For example, you can use this handler to animate layout changes.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Full-Screen-Experiences","text":"Full Screen Experiences"},{"inlineContent":[{"text":"Felt provides several full screen experiences you can explicitly present. See the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenExperience","type":"reference"},{"text":" ","type":"text"},{"type":"codeVoice","code":"struct"},{"type":"text","text":" for available options."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["EmbeddedCare.shared.presentExperience(.splashScreen)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"User interaction with components can automatically present full screen experiences."}]},{"type":"paragraph","inlineContent":[{"text":"Alternately, you can explicitly present full screen experiences using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenViewController","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenView","type":"reference"},{"text":".","type":"text"}]},{"text":"UIKit","anchor":"UIKit","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["let viewController = FullScreenViewController(experience: .pricingScreen)","viewController.modalPresentationStyle = .fullScreen","self.present(viewController, animated: true, completion: nil)","..."]},{"text":"SwiftUI","anchor":"SwiftUI","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","","    @State var shouldPresentEmbeddedCare = false","","    var body: some View {","        MyViewContent($shouldPresentEmbeddedCare)","            .fullScreenCover(isPresented: $shouldPresentEmbeddedCare) {","                FullScreenView(experience: .splashScreen)","            }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK will automatically modally present full screen experiences in response to user actions such as tapping a component."}]},{"text":"Feature Gating","anchor":"Feature-Gating","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"You can check if a feature is enabled for the current user by calling ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true,"type":"reference"},{"text":". See the ","type":"text"},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FeatureGate","isActive":true},{"type":"text","text":" "},{"code":"enum","type":"codeVoice"},{"type":"text","text":" for available options."}]},{"inlineContent":[{"text":"For example, before displaying a component, you should call ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true,"type":"reference"},{"text":" with the relevant feature gate to make sure the component should be displayed.","type":"text"}],"type":"paragraph"},{"code":["if EmbeddedCare.shared.checkFeatureGate(.globalRollout) {","    \/\/ View logic to display `ComponentView`","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Deep-Linking","type":"heading","text":"Deep Linking","level":2},{"inlineContent":[{"text":"The SDK can handle certain deep-links to embedded care content through either urls or push notifications.","type":"text"},{"text":" ","type":"text"},{"text":"In your open-url and push notification handling code, call ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleURL(_:)"},{"text":"","type":"text"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleNotification(_:)"},{"text":" respectively to give the SDK an opportunity to respond to a deep-link event. Use ","type":"text"},{"type":"codeVoice","code":"EmbeddedCare.shared.processStoredDeeplinks()"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"text":"the UI is in a stable state, to ensure that the latest deep links are called.","type":"text"}],"type":"paragraph"},{"anchor":"Compatiblity","type":"heading","text":"Compatiblity","level":2},{"inlineContent":[{"text":"The SDK has minimum version requirements of Swift 5.5 and iOS 15.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare"]]},"references":{"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/ComponentView":{"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ComponentView"}],"url":"\/documentation\/feltembeddedcare\/componentview","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentView","abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UIView"},{"type":"text","text":" used to integrate Felt’s embedded care content alongside your app’s native "},{"type":"codeVoice","code":"UIKit"},{"type":"text","text":" content."}],"title":"ComponentView","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ComponentView"}]},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/EmbeddedCare/shared":{"abstract":[],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"shared","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@M@FeltEmbeddedCare@objc(cs)EmbeddedCare","text":"EmbeddedCare","kind":"typeIdentifier"}],"kind":"symbol","type":"topic","role":"symbol","url":"\/documentation\/feltembeddedcare\/embeddedcare\/shared","title":"shared","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/shared"},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCar