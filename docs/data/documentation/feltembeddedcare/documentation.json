{"hierarchy":{"paths":[["doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare"]]},"sections":[],"abstract":[{"type":"text","text":"Felt offers a seamless telehealth experience inside health apps. Our platform handles the full user lifecycle, including onboarding, payments, and doctor visits, ensuring a cohesive healthcare experience."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Initialization","anchor":"Initialization","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Primary interaction with the SDK is mediated through the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/shared","isActive":true},{"type":"text","text":" singleton."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"At app launch, initialize the SDK with your SDK key using "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/initialize(sdkKey:)","isActive":true},{"type":"text","text":"."}]},{"type":"heading","text":"UIKit","anchor":"UIKit","level":3},{"type":"codeListing","syntax":"swift","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","class AppDelegate: UIApplicationDelegate {","    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        Task {","            do {","                try await EmbeddedCare.shared.initalize(sdkKey: feltSDKKey)","                \/\/ Update any UI waiting on embedded care initialization","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","}"]},{"type":"heading","text":"SwiftUI","anchor":"SwiftUI","level":3},{"type":"codeListing","syntax":"swift","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","@main","struct ClientApp: App {","","    @State var embeddedCareInitialized = false","","    init() {","        Task {","            do {","                try await EmbeddedCare.shared.initialize(sdkKey: sdkKey)","                embeddedCareInitialized = true","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","","}"]},{"type":"heading","text":"User Account and Patient Details","anchor":"User-Account-and-Patient-Details","level":2},{"type":"heading","text":"Account","anchor":"Account","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once your app’s current user has been authenticated, provide their account details to the SDK using "},{"type":"codeVoice","code":"EmbeddedCare\/account"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["let user = ...","EmbeddedCare.shared.account = Account(id: user.id, email: user.email)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user logs out, inform the SDK by setting "},{"type":"codeVoice","code":"EmbeddedCare\/account"},{"type":"text","text":" to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["EmbeddedCare.shared.account = nil"]},{"type":"heading","text":"Selected Patient","anchor":"Selected-Patient","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK considers the logged in person currently using your app to be a "},{"type":"codeVoice","code":"patient"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Your user’s account may be the same person or a distinct person from the actual patient using your app."},{"type":"text","text":" "},{"type":"text","text":"For example, the account holder may be a parent and the patient may be their child."},{"type":"text","text":" "},{"type":"text","text":"Even if the account holder and patient represent the same person, take care to distinguish their ids"},{"type":"text","text":" "},{"type":"text","text":"if your app’s data model keeps them distinct."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Account\/selectedPatient","isActive":true},{"type":"text","text":" property to provide patient details to the SDK for the currently logged in patient."}]},{"type":"codeListing","syntax":"swift","code":["let currentFamilyMember = ...","EmbeddedCare.shared.account?.selectedPatient = Patient(","    id: currentFamilyMember.id,","    relationshipToAccountHolder: .familyMember,","    email: currentFamilyMember.email,","    \/\/ Any custom information you want to provide","    custom: [\"notes\" : currentFamilyMember.notes]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If any information changes about the account or the selected patient, just update "},{"type":"codeVoice","code":"EmbeddedCare\/account"},{"type":"text","text":" with the latest information."}]},{"type":"heading","text":"Component Experiences","anchor":"Component-Experiences","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In order to integrate Felt embedded care content alongside your app’s native content, use "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentView","isActive":true},{"type":"text","text":", a "},{"type":"codeVoice","code":"UIView"},{"type":"text","text":" subclass, or "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Component","isActive":true},{"type":"text","text":", a "},{"type":"codeVoice","code":"SwiftUI"},{"type":"text","text":" "},{"type":"codeVoice","code":"View"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentExperience","isActive":true},{"type":"text","text":" "},{"type":"codeVoice","code":"enum"},{"type":"text","text":" for available options."}]},{"type":"heading","text":"UIKit","anchor":"UIKit","level":3},{"type":"codeListing","syntax":"swift","code":["let componentView = ComponentView(experience: .dismissableCallToAction, custom: [:])","self.view.addSubview(componentView)","..."]},{"type":"heading","text":"SwiftUI","anchor":"SwiftUI","level":3},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    var body: some View {","        Component(experience: .dismissableCallToAction, custom: [:])","    }","}"]},{"type":"heading","text":"Layout","anchor":"Layout","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Component contents may be loaded asynchronously, which means a component’s layout can change over time. A component determines its intrinsic height based on its current width."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"type":"codeVoice","code":"UIKit"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SwiftUI"},{"type":"text","text":" components provide the ability to specify an "},{"type":"codeVoice","code":"onHeightUpdated"},{"type":"text","text":" handler that allows you to react to intrinsic height changes. For example, you can use this handler to animate layout changes."}]},{"type":"heading","text":"Full Screen Experiences","anchor":"Full-Screen-Experiences","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Felt provides several full screen experiences you can explicitly present. See the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenExperience","isActive":true},{"type":"text","text":" "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" for available options."}]},{"type":"codeListing","syntax":"swift","code":["EmbeddedCare.shared.presentExperience(.splashScreen)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"User interaction with components can automatically present full screen experiences."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternately, you can explicitly present full screen experiences using "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenViewController","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenView","isActive":true},{"type":"text","text":"."}]},{"type":"heading","text":"UIKit","anchor":"UIKit","level":3},{"type":"codeListing","syntax":"swift","code":["let viewController = FullScreenViewController(experience: .pricingScreen)","viewController.modalPresentationStyle = .fullScreen","self.present(viewController, animated: true, completion: nil)","..."]},{"type":"heading","text":"SwiftUI","anchor":"SwiftUI","level":3},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","","    @State var shouldPresentEmbeddedCare = false","","    var body: some View {","        MyViewContent($shouldPresentEmbeddedCare)","            .fullScreenCover(isPresented: $shouldPresentEmbeddedCare) {","                FullScreenView(experience: .splashScreen)","            }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK will automatically modally present full screen experiences in response to user actions such as tapping a component."}]},{"type":"heading","text":"Feature Gating","anchor":"Feature-Gating","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can check if a feature is enabled for the current user by calling "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true},{"type":"text","text":". See the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FeatureGate","isActive":true},{"type":"text","text":" "},{"type":"codeVoice","code":"enum"},{"type":"text","text":" for available options."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, before displaying a component, you should call "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true},{"type":"text","text":" with the relevant feature gate to make sure the component should be displayed."}]},{"type":"codeListing","syntax":"swift","code":["if EmbeddedCare.shared.checkFeatureGate(.globalRollout) {","    \/\/ View logic to display `ComponentView`","}"]},{"type":"heading","text":"Deep Linking","anchor":"Deep-Linking","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK can handle certain deep-links to embedded care content through either urls or push notifications."},{"type":"text","text":" "},{"type":"text","text":"In your open-url and push notification handling code, call "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleURL(_:)","isActive":true},{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleNotification(_:)","isActive":true},{"type":"text","text":" respectively to give the SDK an opportunity to respond to a deep-link event. Use "},{"type":"codeVoice","code":"EmbeddedCare.shared.processStoredDeeplinks()"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"the UI is in a stable state, to ensure that the latest deep links are called."}]},{"type":"heading","text":"Compatiblity","anchor":"Compatiblity","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK has minimum version re