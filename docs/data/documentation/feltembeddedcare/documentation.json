{"metadata":{"modules":[{"name":"FeltEmbeddedCare"}],"role":"article","title":"Felt Embedded Care iOS SDK","roleHeading":"Article"},"abstract":[{"text":"Felt offers a seamless telehealth experience inside health apps. Our platform handles the full user lifecycle, including onboarding, payments, and doctor visits, ensuring a cohesive healthcare experience.","type":"text"}],"identifier":{"url":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Documentation","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/feltembeddedcare\/documentation"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/feltembeddedcare\/documentation"],"traits":[{"interfaceLanguage":"occ"}]}],"primaryContentSections":[{"content":[{"level":2,"text":"Initialization","type":"heading","anchor":"Initialization"},{"inlineContent":[{"type":"text","text":"Primary interaction with the SDK is mediated through the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/shared","isActive":true},{"text":" singleton.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"At app launch, initialize the SDK with your SDK key using ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/initialize(sdkKey:)"},{"text":".","type":"text"}]},{"anchor":"UIKit","type":"heading","level":3,"text":"UIKit"},{"syntax":"swift","type":"codeListing","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","class AppDelegate: UIApplicationDelegate {","    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        Task {","            do {","                try await EmbeddedCare.shared.initalize(sdkKey: feltSDKKey)","                \/\/ Update any UI waiting on embedded care initialization","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","}"]},{"text":"SwiftUI","anchor":"SwiftUI","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","@main","struct ClientApp: App {","","    @State var embeddedCareInitialized = false","","    init() {","        Task {","            do {","                try await EmbeddedCare.shared.initialize(sdkKey: sdkKey)","                embeddedCareInitialized = true","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","","}"]},{"type":"heading","text":"User Account and Patient Details","level":2,"anchor":"User-Account-and-Patient-Details"},{"anchor":"Account","text":"Account","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once your app’s current user has been authenticated, provide their account details to the SDK using "},{"type":"codeVoice","code":"EmbeddedCare\/account"},{"type":"text","text":"."}]},{"code":["let user = ...","EmbeddedCare.shared.account = Account(id: user.id, email: user.email)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user logs out, inform the SDK by setting "},{"code":"EmbeddedCare\/account","type":"codeVoice"},{"type":"text","text":" to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["EmbeddedCare.shared.account = nil"]},{"type":"heading","text":"Selected Patient","level":3,"anchor":"Selected-Patient"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK considers the logged in person currently using your app to be a "},{"type":"codeVoice","code":"patient"},{"type":"text","text":"."},{"type":"text","text":" "},{"text":"Your user’s account may be the same person or a distinct person from the actual patient using your app.","type":"text"},{"text":" ","type":"text"},{"text":"For example, the account holder may be a parent and the patient may be their child.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Even if the account holder and patient represent the same person, take care to distinguish their ids"},{"type":"text","text":" "},{"text":"if your app’s data model keeps them distinct.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Set the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Account\/selectedPatient","type":"reference"},{"text":" property to provide patient details to the SDK for the currently logged in patient.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let currentFamilyMember = ...","EmbeddedCare.shared.account?.selectedPatient = Patient(","    id: currentFamilyMember.id,","    relationshipToAccountHolder: .familyMember,","    email: currentFamilyMember.email,","    \/\/ Any custom information you want to provide","    custom: [\"notes\" : currentFamilyMember.notes]",")"]},{"inlineContent":[{"type":"text","text":"If any information changes about the account or the selected patient, just update "},{"type":"codeVoice","code":"EmbeddedCare\/account"},{"type":"text","text":" with the latest information."}],"type":"paragraph"},{"anchor":"Component-Experiences","type":"heading","level":2,"text":"Component Experiences"},{"inlineContent":[{"type":"text","text":"In order to integrate Felt embedded care content alongside your app’s native content, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentView"},{"type":"text","text":", a "},{"type":"codeVoice","code":"UIView"},{"type":"text","text":" subclass, or "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Component","isActive":true},{"text":", a ","type":"text"},{"type":"codeVoice","code":"SwiftUI"},{"text":" ","type":"text"},{"type":"codeVoice","code":"View"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentExperience","type":"reference"},{"text":" ","type":"text"},{"type":"codeVoice","code":"enum"},{"text":" for available options.","type":"text"}]},{"text":"UIKit","anchor":"UIKit","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["let componentView = ComponentView(experience: .dismissableCallToAction, custom: [:])","self.view.addSubview(componentView)","..."]},{"text":"SwiftUI","anchor":"SwiftUI","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    var body: some View {","        Component(experience: .dismissableCallToAction, custom: [:])","    }","}"]},{"text":"Layout","anchor":"Layout","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Component contents may be loaded asynchronously, which means a component’s layout can change over time. A component determines its intrinsic height based on its current width.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Both "},{"type":"codeVoice","code":"UIKit"},{"type":"text","text":" and "},{"type":"codeVoice","code":"SwiftUI"},{"type":"text","text":" components provide the ability to specify an "},{"type":"codeVoice","code":"onHeightUpdated"},{"type":"text","text":" handler that allows you to react to intrinsic height changes. For example, you can use this handler to animate layout changes."}],"type":"paragraph"},{"text":"Full Screen Experiences","anchor":"Full-Screen-Experiences","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Felt provides several full screen experiences you can explicitly present. See the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenExperience","isActive":true},{"type":"text","text":" "},{"type":"codeVoice","code":"struct"},{"type":"text","text":" for available options."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["EmbeddedCare.shared.presentExperience(.splashScreen)"]},{"inlineContent":[{"type":"text","text":"User interaction with components can automatically present full screen experiences."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Alternately, you can explicitly present full screen experiences using "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenViewController","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenView","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"UIKit","anchor":"UIKit","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["let viewController = FullScreenViewController(experience: .pricingScreen)","viewController.modalPresentationStyle = .fullScreen","self.present(viewController, animated: true, completion: nil)","..."]},{"text":"SwiftUI","anchor":"SwiftUI","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","","    @State var shouldPresentEmbeddedCare = false","","    var body: some View {","        MyViewContent($shouldPresentEmbeddedCare)","            .fullScreenCover(isPresented: $shouldPresentEmbeddedCare) {","                FullScreenView(experience: .splashScreen)","            }","    }","}"]},{"inlineContent":[{"type":"text","text":"The SDK will automatically modally present full screen experiences in response to user actions such as tapping a component."}],"type":"paragraph"},{"text":"Feature Gating","anchor":"Feature-Gating","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"You can check if a feature is enabled for the current user by calling "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true},{"type":"text","text":". See the "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FeatureGate","isActive":true},{"type":"text","text":" "},{"type":"codeVoice","code":"enum"},{"type":"text","text":" for available options."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, before displaying a component, you should call "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","isActive":true},{"type":"text","text":" with the relevant feature gate to make sure the component should be displayed."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if EmbeddedCare.shared.checkFeatureGate(.globalRollout) {","    \/\/ View logic to display `ComponentView`","}"]},{"text":"Deep Linking","anchor":"Deep-Linking","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The SDK can handle certain deep-links to embedded care content through either urls or push notifications."},{"type":"text","text":" "},{"type":"text","text":"In your open-url and push notification handling code, call "},{"type":"codeVoice","code":"EmbeddedCare\/handleURL(_:)"},{"type":"text","text":""},{"type":"text","text":" "},{"type":"text","text":"or "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleNotification(_:)","isActive":true},{"type":"text","text":" respectively to give the SDK an opportunity to respond to a deep-link event. Use "},{"type":"codeVoice","code":"EmbeddedCare.shared.processStoredDeeplinks()"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"the UI is in a stable state, to ensure that the latest deep links are called."}],"type":"paragraph"},{"text":"Compatiblity","anchor":"Compatiblity","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The SDK has minimum version requirements of Swift 5.5 and iOS 15."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/EmbeddedCare/handleNotification(_:)":{"kind":"symbol","title":"handleNotification(_:)","abstract":[],"url":"\/documentation\/feltembeddedcare\/embeddedcare\/handlenotification(_:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"handleNotification"},{"kind":"text","text":"("},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)UNNotification","text":"UNNotification"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleNotification(_:)"},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/ComponentExperience":{"kind":"symbol","role":"symbol","url":"\/documentation\/feltembeddedcare\/componentexperience","type":"topic","abstract":[{"type":"text","text":"An experience associated with a component view that is displayed alongside"},{"type":"text","text":" "},{"type":"text","text":"your app’s native content"}],"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentExperience","title":"ComponentExperience","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ComponentExperience","kind":"identifier"}],"navigatorTitle":[{"text":"ComponentExperience","kind":"identifier"}]},"doc://clinic.felt.EmbeddedCare/documentation/FeltEmbeddedCare/EmbeddedCare/ch