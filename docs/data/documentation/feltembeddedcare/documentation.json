{"hierarchy":{"paths":[["doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Documentation"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Initialization","text":"Initialization"},{"type":"paragraph","inlineContent":[{"text":"Primary interaction with the SDK is mediated through the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/shared"},{"type":"text","text":" singleton."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"At app launch, initialize the SDK with your SDK key using "},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/initialize(sdkKey:)","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"text":"UIKit","anchor":"UIKit","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","class AppDelegate: UIApplicationDelegate {","    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {","        Task {","            do {","                try await EmbeddedCare.shared.initalize(sdkKey: feltSDKKey)","                \/\/ Update any UI waiting on embedded care initialization","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","}"]},{"type":"heading","level":3,"text":"SwiftUI","anchor":"SwiftUI"},{"type":"codeListing","syntax":"swift","code":["import FeltEmbeddedCare","","let feltSDKKey = \"...\"","","@main","struct ClientApp: App {","","    @State var embeddedCareInitialized = false","","    init() {","        Task {","            do {","                try await EmbeddedCare.shared.initialize(sdkKey: sdkKey)","                embeddedCareInitialized = true","            } catch {","                \/\/ Error will be thrown for invalid key","            }","        }","    }","","}"]},{"text":"User Account and Patient Details","anchor":"User-Account-and-Patient-Details","type":"heading","level":2},{"text":"Account","anchor":"Account","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Once your app’s current user has been authenticated, provide their account details to the SDK using "},{"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/AuthManager\/account","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"code":["let user = ...","EmbeddedCare.shared.auth.account = Account(id: user.id, email: user.email)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When the user logs out, inform the SDK by setting "},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/AuthManager\/account","type":"reference"},{"type":"text","text":" to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["EmbeddedCare.shared.auth.account = nil"],"syntax":"swift","type":"codeListing"},{"text":"Selected Patient","anchor":"Selected-Patient","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The SDK considers the logged in person currently using your app to be a "},{"code":"patient","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Your user’s account may be the same person or a distinct person from the actual patient using your app."},{"type":"text","text":" "},{"type":"text","text":"For example, the account holder may be a parent and the patient may be their child."},{"type":"text","text":" "},{"type":"text","text":"Even if the account holder and patient represent the same person, take care to distinguish their ids"},{"type":"text","text":" "},{"type":"text","text":"if your app’s data model keeps them distinct."}],"type":"paragraph"},{"inlineContent":[{"text":"Set the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Account\/selectedPatient"},{"text":" property to provide patient details to the SDK for the currently logged in patient.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let currentFamilyMember = ...","EmbeddedCare.shared.auth.account?.selectedPatient = Patient(","    id: currentFamilyMember.id,","    relationshipToAccountHolder: .familyMember,","    email: currentFamilyMember.email,","    \/\/ Any custom information you want to provide","    custom: [\"notes\" : currentFamilyMember.notes]",")"]},{"inlineContent":[{"text":"If any information changes about the account or the selected patient, just update ","type":"text"},{"code":"EmbeddedCare\/account","type":"codeVoice"},{"text":" with the latest information.","type":"text"}],"type":"paragraph"},{"text":"Component Experiences","anchor":"Component-Experiences","type":"heading","level":2},{"inlineContent":[{"text":"In order to integrate Felt embedded care content alongside your app’s native content, use ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentView","isActive":true,"type":"reference"},{"text":", a ","type":"text"},{"code":"UIView","type":"codeVoice"},{"text":" subclass, or ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/Component","isActive":true,"type":"reference"},{"text":", a ","type":"text"},{"code":"SwiftUI","type":"codeVoice"},{"text":" ","type":"text"},{"code":"View","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/ComponentExperience"},{"text":" ","type":"text"},{"type":"codeVoice","code":"enum"},{"text":" for available options.","type":"text"}],"type":"paragraph"},{"text":"UIKit","anchor":"UIKit","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["let componentView = ComponentView(experience: .dismissableCallToAction, custom: [:])","self.view.addSubview(componentView)","..."]},{"text":"SwiftUI","anchor":"SwiftUI","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    var body: some View {","        Component(experience: .dismissableCallToAction, custom: [:])","    }","}"]},{"type":"heading","level":3,"text":"Layout","anchor":"Layout"},{"inlineContent":[{"text":"Component contents may be loaded asynchronously, which means a component’s layout can change over time. A component determines its intrinsic height based on its current width.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Both ","type":"text"},{"code":"UIKit","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"SwiftUI","type":"codeVoice"},{"text":" components provide the ability to specify an ","type":"text"},{"code":"onHeightUpdated","type":"codeVoice"},{"text":" handler that allows you to react to intrinsic height changes. For example, you can use this handler to animate layout changes.","type":"text"}],"type":"paragraph"},{"anchor":"Full-Screen-Experiences","level":2,"text":"Full Screen Experiences","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Felt provides several full screen experiences you can explicitly present. See the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenExperience","type":"reference"},{"text":" ","type":"text"},{"code":"struct","type":"codeVoice"},{"text":" for available options.","type":"text"}]},{"type":"codeListing","code":["EmbeddedCare.shared.presentExperience(.splashScreen)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"User interaction with components can automatically present full screen experiences.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Alternately, you can explicitly present full screen experiences using "},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenViewController","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FullScreenView","type":"reference"},{"type":"text","text":"."}]},{"text":"UIKit","anchor":"UIKit","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["let viewController = FullScreenViewController(experience: .pricingScreen)","viewController.modalPresentationStyle = .fullScreen","self.present(viewController, animated: true, completion: nil)","..."]},{"level":3,"type":"heading","text":"SwiftUI","anchor":"SwiftUI"},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","","    @State var shouldPresentEmbeddedCare = false","","    var body: some View {","        MyViewContent($shouldPresentEmbeddedCare)","            .fullScreenCover(isPresented: $shouldPresentEmbeddedCare) {","                FullScreenView(experience: .splashScreen)","            }","    }","}"]},{"inlineContent":[{"text":"The SDK will automatically modally present full screen experiences in response to user actions such as tapping a component.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Feature Gating","anchor":"Feature-Gating"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can check if a feature is enabled for the current user by calling "},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)","type":"reference","isActive":true},{"text":". See the ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/FeatureGate","type":"reference","isActive":true},{"text":" ","type":"text"},{"code":"enum","type":"codeVoice"},{"text":" for available options.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For example, before displaying a component, you should call "},{"type":"reference","isActive":true,"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/checkFeatureGate(_:)"},{"text":" with the relevant feature gate to make sure the component should be displayed.","type":"text"}]},{"code":["if EmbeddedCare.shared.checkFeatureGate(.globalRollout) {","    \/\/ View logic to display `ComponentView`","}"],"type":"codeListing","syntax":"swift"},{"text":"Deep Linking","anchor":"Deep-Linking","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The SDK can handle certain deep-links to embedded care content through either urls or push notifications."},{"type":"text","text":" "},{"text":"In your open-url and push notification handling code, call ","type":"text"},{"code":"EmbeddedCare\/handleURL(_:)","type":"codeVoice"},{"text":"","type":"text"},{"type":"text","text":" "},{"text":"or ","type":"text"},{"identifier":"doc:\/\/clinic.felt.EmbeddedCare\/documentation\/FeltEmbeddedCare\/EmbeddedCare\/handleNotification(_:)","isActive":true,"type":"reference"},{"text":" respectively to give the SDK an opportunity to respond to a deep-link event. Use ","type":"text"},{"code":"EmbeddedCare.shared.processStoredDeeplinks()","type":"codeVoice"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"text":"the UI is in a stable state, to ensure that the latest deep links are called.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Compatiblity","anchor":"Compatiblity"},{"inlineContent":[{"type":"text","text":"The SDK has minimum version requirements of Swift 5.5 and iOS 15."}],"type":"paragraph"}]}],"variants":[{"paths":["\/doc